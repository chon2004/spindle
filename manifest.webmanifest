{
  "id": "spindle-player",
  "name": "Spindle",
  "short_name": "Spindle",
  "description": "A player for the music files on your own phone.",
  "lang": "en",
  "start_url": "./",
  "scope": "./",
  "display": "standalone",
  "display_override": [
    "standalone",
    "minimal-ui"
  ],
  "orientation": "portrait",
  "background_color": "#E7E3D7",
  "theme_color": "#E7E3D7",
  "categories": [
    "music",
    "entertainment"
  ],
  "icons": [
    {
      "src": "icon-192.png",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "icon-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "icon-maskable-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "maskable"
    }
  ],
  "shortcuts": [
    {
      "name": "Shuffle everything",
      "short_name": "Shuffle",
      "description": "Play your whole library in random order",
      "url": "./?do=shuffle",
      "icons": [
        {
          "src": "sc-shuffle.png",
          "sizes": "192x192",
          "type": "image/png"
        }
      ]
    },
    {
      "name": "Resume",
      "short_name": "Resume",
      "description": "Pick up where you left off",
      "url": "./?do=resume",
      "icons": [
        {
          "src": "sc-resume.png",
          "sizes": "192x192",
          "type": "image/png"
        }
      ]
    },
    {
      "name": "Playlists",
      "short_name": "Playlists",
      "description": "Go straight to your playlists",
      "url": "./?do=playlists",
      "icons": [
        {
          "src": "sc-lists.png",
          "sizes": "192x192",
          "type": "image/png"
        }
      ]
    }
  ]
}